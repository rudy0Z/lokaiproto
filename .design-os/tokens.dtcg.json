{
  "color": {
    "$type": "color",
    "canvas": { "$value": { "colorSpace": "srgb", "components": [0.973, 0.961, 0.933], "alpha": 1 } },
    "surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1 } },
    "surfaceSubtle": { "$value": { "colorSpace": "srgb", "components": [0.965, 0.953, 0.925], "alpha": 1 } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.094, 0.09, 0.075], "alpha": 1 } },
    "inkSecondary": { "$value": { "colorSpace": "srgb", "components": [0.282, 0.271, 0.239], "alpha": 1 } },
    "inkMuted": { "$value": { "colorSpace": "srgb", "components": [0.408, 0.392, 0.365], "alpha": 1 } },
    "border": { "$value": { "colorSpace": "srgb", "components": [0.906, 0.878, 0.831], "alpha": 1 } },
    "navy": { "$value": { "colorSpace": "srgb", "components": [0.063, 0.165, 0.298], "alpha": 1 } },
    "saffron": { "$value": { "colorSpace": "srgb", "components": [0.8, 0.353, 0.063], "alpha": 1 } },
    "terracottaAccessible": { "$value": { "colorSpace": "srgb", "components": [0.663, 0.31, 0.176], "alpha": 1 } },
    "success": { "$value": { "colorSpace": "srgb", "components": [0.122, 0.42, 0.227], "alpha": 1 } },
    "danger": { "$value": { "colorSpace": "srgb", "components": [0.431, 0.122, 0.122], "alpha": 1 } }
  },
  "dimension": {
    "$type": "dimension",
    "space1": { "$value": { "value": 4, "unit": "px" } },
    "space2": { "$value": { "value": 8, "unit": "px" } },
    "space3": { "$value": { "value": 12, "unit": "px" } },
    "space4": { "$value": { "value": 16, "unit": "px" } },
    "space5": { "$value": { "value": 24, "unit": "px" } },
    "space6": { "$value": { "value": 32, "unit": "px" } },
    "radiusControl": { "$value": { "value": 10, "unit": "px" } },
    "radiusCard": { "$value": { "value": 14, "unit": "px" } },
    "radiusDialog": { "$value": { "value": 18, "unit": "px" } },
    "touchTarget": { "$value": { "value": 44, "unit": "px" } }
  },
  "duration": {
    "$type": "duration",
    "micro": { "$value": { "value": 120, "unit": "ms" } },
    "state": { "$value": { "value": 220, "unit": "ms" } },
    "dialog": { "$value": { "value": 280, "unit": "ms" } }
  }
}
